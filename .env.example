# -----------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------

# Shared secret callers must pass in the x-api-key request header.
# Generate a strong random value: openssl rand -hex 32
API_SECRET_KEY=replace-with-a-strong-random-secret

# -----------------------------------------------------------------------
# Netlify build hook URLs
# -----------------------------------------------------------------------
# Pattern: NETLIFY_HOOK_<PROJECT>_<ENVIRONMENT>
#
# <PROJECT>  — upper-snake-case version of the ?project= query param
#              (hyphens in the param are converted to underscores automatically)
# <ENVIRONMENT> — STAGING or PRODUCTION
#
# Find / create build hooks in:
# Netlify dashboard → Site → Site configuration → Build hooks
# -----------------------------------------------------------------------

# Example project "my-app" (called via ?project=my-app or ?project=MY_APP)
NETLIFY_HOOK_MY_APP_STAGING=https://api.netlify.com/build_hooks/REPLACE_WITH_STAGING_HOOK_ID
NETLIFY_HOOK_MY_APP_PRODUCTION=https://api.netlify.com/build_hooks/REPLACE_WITH_PRODUCTION_HOOK_ID

# Add more projects by following the same pattern, e.g.:
# NETLIFY_HOOK_ANOTHER_SITE_STAGING=https://api.netlify.com/build_hooks/...
# NETLIFY_HOOK_ANOTHER_SITE_PRODUCTION=https://api.netlify.com/build_hooks/...

# -----------------------------------------------------------------------
# Local dev only (not used on Netlify)
# -----------------------------------------------------------------------
PORT=3000
